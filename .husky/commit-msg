#!/bin/sh

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# List of vague messages
vague_patterns="fix|update|changes|misc|done|test|temp|wip|ok|change"

# Min length required
min_length=15

# Check message length
if [ ${#commit_msg} -lt $min_length ]; then
  echo "❌ Commit message is too short. Must be at least $min_length characters."
  exit 1
fi

# Reject vague messages (case-insensitive)
if echo "$commit_msg" | grep -iqE "^($vague_patterns)(\s|$)"; then
  echo "❌ Commit message '$commit_msg' is too vague!"
  echo "👉 Write something meaningful (e.g., 'Fix null ref in EmployeeService')"
  exit 1
fi

echo "✔ Commit message is valid!"
exit 0
dotnet husky run
