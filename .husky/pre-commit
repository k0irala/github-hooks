#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🚫 Checking if you are committing to 'main'..."

current_branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ]; then
  echo "❌ Direct commits to '$current_branch' are not allowed."
  echo "👉 Create a feature branch instead."
  exit 1
fi

echo "✔ Not on main branch. Proceeding..."

echo "🧹 Running dotnet format..."
dotnet format

if [ $? -ne 0 ]; then
  echo "❌ dotnet format failed. Fix formatting issues and try again."
  exit 1
fi

echo "✔ Formatting completed."

echo "🧪 Running dotnet test..."
dotnet test --no-build --verbosity quiet

if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Fix the test failures before committing."
  exit 1
fi

echo "✔ All tests passed. Commit allowed."
