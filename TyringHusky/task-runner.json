{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
     {
      "name": "welcome-message-example",
      "command": "bash",
      "args": ["-c", "echo Husky.Net is awesome!"],
      "windows": {
        "command": "cmd",
        "args": ["/c", "echo Husky.Net is awesome!"]
      }
    },
    {
      "name": "backend-restore",
      "group": "pre-push",
      "command": "dotnet",
      "args": ["restore"],
      "cwd": "./TryingHusky"
    },
    {
      "name": "backend-build",
      "group": "pre-push",
      "command": "dotnet",
      "args": ["build", "--no-restore"],
      "cwd": "./TryingHusky"
    },
    {
      "name": "backend-test",
      "group": "pre-push",
      "command": "dotnet",
      "args": ["test", "--no-build"],
      "cwd": "./TryingHusky"
    }
  ]
}
