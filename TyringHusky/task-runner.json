{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
     {
      "name": "welcome-message-example",
      "command": "bash",
      "args": ["-c", "echo Husky.Net is awesome!"],
      "windows": {
        "command": "cmd",
        "args": ["/c", "echo Husky.Net is awesome!"]
      }
    },
    {
      "name": "backend-restore",
      "group": "pre-push",
      "command": "dotnet",
       "args": ["restore", "cd TyringHusky/TyringHusky.csproj"]
    },
    {
      "name": "backend-build",
      "group": "pre-push",
      "command": "dotnet",
      "args": ["build", "cd TyringHusky/TyringHusky.csproj", "--no-restore", "-c", "Release"]
    }
  ]
}
